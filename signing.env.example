# Copy to signing.env (gitignored) and fill in. KEY=VALUE per line; nothing is executed,
# and quotes are optional. Command-line flags and environment variables override this file.
# With no team or identity configured, ./build.sh makes an ad-hoc build without the widget.

# Your Apple Developer team ID (10 characters), as in the OU of your signing certificate.
# The widget's App Group is <team>.<CFBundleIdentifier>, so it follows this value.
TEA_TEAM_ID=ABCDE12345

# Optional. When unset, build.sh picks the valid identity of that team: "Apple Development: …"
# for dev builds and "Developer ID Application: …" for --release. Set TEA_SIGN_IDENTITY
# to - for an ad-hoc dev build; --release always needs a Developer ID identity.
#TEA_SIGN_IDENTITY=Apple Development: Your Name (PERSONAL01)
#TEA_RELEASE_IDENTITY=Developer ID Application: Your Name (ABCDE12345)

# Optional. The notarytool keychain profile Scripts/release.sh uses (default tea-notary).
#TEA_NOTARY_PROFILE=tea-notary
